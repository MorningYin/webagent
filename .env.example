# Copy to .env and fill in real values. .env is gitignored.
# LiteLLM proxy: relay gateway /v1 bases + API keys.
LITELLM_HEIDUOKE_BASE="https://<heiduoke-gateway>/v1"
LITELLM_DKYX_BASE="https://<dkyx-gateway>/v1"
LITELLM_YUNWU_BASE="https://<yunwu-gateway>/v1"
# Policy API keys (relay-station keys for gpt-5.4 / gpt-5.4-mini / gpt-5.5)
POLICY_API_KEY_YUNWU="sk-..."
POLICY_API_KEY_NEWAPI="sk-..."
POLICY_API_KEY_NEWAPI2="sk-..."
POLICY_API_KEY_NEWAPI3="sk-..."
POLICY_API_KEY_NEWAPI4="sk-..."
# local-only auth token between rollout and the proxy
LITELLM_MASTER_KEY="sk-local-webgym-pool"
